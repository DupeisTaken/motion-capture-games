{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://motion-capture-games.local/contracts/preview-v1.json",
  "title": "PreviewFrame",
  "description": "Independent diagnostic image metadata. This frame is not necessarily the frame of the latest pose observation. Both timestamps use the same backend monotonic clock; exposure time is unknown.",
  "type": "object", "additionalProperties": false,
  "required": ["version", "epoch", "sequence", "source", "image", "capturedAtNs", "clockDomain", "clockQuality", "captureFps"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "epoch": {"type": "string", "minLength": 1, "maxLength": 128},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "source": {"enum": ["camera", "demo"]},
    "image": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1, "maximum": 16384}, "height": {"type": "integer", "minimum": 1, "maximum": 16384}}},
    "capturedAtNs": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 30},
    "clockDomain": {"const": "host-monotonic"},
    "clockQuality": {"enum": ["host-read-completion", "synthetic"]},
    "captureFps": {"type": "number", "minimum": 0, "maximum": 10000}
  }
}
