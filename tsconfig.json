{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "apps/mirror/src",
    "packages/*/src",
    "games/*/src",
    "contracts/src",
    "contracts/generated",
    "tests/**/*.ts",
    "vite.config.ts"
  ]
}
